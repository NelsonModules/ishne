  <language>fr_FR</language>
  <keyword>ishne.tobytes</keyword>
  <short_description>Serialiser un enregistrement ISHNE en octets sans ecrire sur le disque.</short_description>
  <syntax>
    <syntax_item>bytes = ishne.tobytes(r)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>r</param_name>
      <param_description>la structure neutre a serialiser, issue de ishne.read ou construite a la main.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>bytes</param_name>
      <param_description>les octets d'un fichier ISHNE valide.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Serialise la structure neutre dans les octets d'un fichier ISHNE valide sans ecrire sur le disque, pour un appelant qui enverra l'enregistrement sur un flux ou le gardera dans un blob. C'est l'inverse de ishne.frombytes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[bytes = ishne.tobytes(r);
back = ishne.frombytes(bytes);]]></example_item_data>
    </example_item>
  </examples>
