  <language>en_US</language>
  <keyword>ishne.select</keyword>
  <short_description>Keep only some leads of an ISHNE record.</short_description>
  <syntax>
    <syntax_item>r = ishne.select(r, which)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>r</param_name>
      <param_description>a struct from ishne.read.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>which</param_name>
      <param_description>the leads to keep, by name (a char or a cellstr) or by index, in the order asked.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description>the struct with only the chosen leads, in the order asked.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Keeps only some leads of the struct from ishne.read. The samples columns and every per-lead field (codes, names, resolution, quality) are narrowed together, so the record stays consistent.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[r = ishne.read('holter.ecg');
r = ishne.select(r, [1 2]);]]></example_item_data>
    </example_item>
  </examples>
