  <language>en_US</language>
  <keyword>ishne.header</keyword>
  <short_description>Read only the header of an ISHNE file.</short_description>
  <syntax>
    <syntax_item>r = ishne.header(file)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>file</param_name>
      <param_description>the path to the ISHNE file.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description>the same neutral struct ishne.read returns, but with no samples.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Reads only the header of an ISHNE file, so the leads, their resolutions and the recording's metadata can be inspected cheaply, without reading the samples. It is the shorthand for ishne.read(file, 'Data', false).</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[r = ishne.header('holter.ecg');
disp(r.leadNames);]]></example_item_data>
    </example_item>
  </examples>
