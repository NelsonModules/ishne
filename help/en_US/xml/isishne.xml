  <language>en_US</language>
  <keyword>ishne.isishne</keyword>
  <short_description>Probe a file for the ISHNE 1.0 format.</short_description>
  <syntax>
    <syntax_item>tf = ishne.isishne(file)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>file</param_name>
      <param_description>the path to probe.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>true when the file begins with the ISHNE1.0 magic and is long enough to hold the fixed header, false otherwise.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>It reads only the first bytes and never throws on a file that is not an ISHNE recording, so it can be asked of any path before a read.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[if ishne.isishne('mystery.dat')
  r = ishne.read('mystery.dat');
end]]></example_item_data>
    </example_item>
  </examples>
